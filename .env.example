# Gemini API key (GRATIS) dari https://aistudio.google.com — wajib diisi.
GEMINI_API_KEY=
# Model gratis yang masih didukung (2.x sudah obsolete). Jangan pakai model -image.
GEMINI_MODEL=gemini-3.6-flash

# Foursquare Places API "Service Key" (BUKAN key lama fsq3... biasa).
# Buat di dashboard Foursquare -> Settings -> Service API Keys -> Generate.
# Endpoint lama /v3/places/search sudah dinonaktifkan.
FOURSQUARE_API_KEY=